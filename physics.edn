;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a facility-management robot keeps herd records,
;; schedules appointments and handles supplies for a horse and equine farm
;; (ISIC 0142). Its physical work in the stable: carrying hay and bedding down
;; the stable aisle, and hanging filled hay nets in the stalls.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-0142"
 :cases
 [{:id :hay-and-bedding-down-stable-aisle
   :kind :transport
   :procedure "stable robot carries hay bales and bedding from the hay store down the stable aisle to the stalls"
   :params {:mass-kg 120.0 :distance-m 60.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.8 :drive-force-n 300.0 :crr 0.04
            :cog-height-m 0.70 :support-half-length-m 0.40 :max-time-s 3600.0}
   :sweep {:param :payload-kg :values [50.0 100.0 150.0 200.0 300.0]}
   :quantity :cycle-time-s
   :limit {:max 75.0 :basis "estimate: one aisle leg inside the morning feeding round's per-stall time"}
   :boundary {:lo 10.0 :hi 800.0}}
  {:id :hay-net-onto-stall-hook
   :kind :manipulator
   :procedure "arm lifts a filled hay net from the cart and hangs it on the stall hook at a horse's head height"
   :params {:l1-m 0.70 :l2-m 0.60 :m1-kg 9.0 :m2-kg 6.0
            :from [0.70 0.00] :to [0.40 1.10] :duration-s 3.0 :steps 600}
   :sweep {:param :payload-kg :values [3.0 6.0 9.0 12.0 15.0]}
   :quantity :peak-tau1-nm
   :limit {:max 200.0 :basis "estimate: continuous shoulder torque of a 20 kg-class industrial arm"}
   :boundary {:lo 0.5 :hi 60.0}}]}
